# Root Production Environment Configuration
# Duplicate this file as .env in production

# Security
JWT_SECRET=replace_with_a_long_random_entropy_secret_64_chars_min
JWT_EXPIRES_IN=7d

# Database (e.g. MongoDB Atlas or internal replica set)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cross_border_fx?retryWrites=true&w=majority

# Backend Networking
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.yourdomain.com,https://yourdomain.com

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Initial Seed Admin Credentials
INITIAL_ADMIN_EMAIL=treasury@yourdomain.com
INITIAL_ADMIN_PASSWORD=SecurePassword2026!
